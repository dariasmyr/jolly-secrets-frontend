{
  "name": "lite-front",
  "version": "1.0.0",
  "license": "MIT",
  "scripts": {
    "________________ BUILD AND RUN ________________": "",
    "postinstall": "npm run prepare",
    "build": "cross-env NODE_ENV=production next build",
    "start:dev": "next",
    "start:prod": "cross-env NODE_ENV=production npx env-cmd --silent next start",
    "analyze": "cross-env ANALYZE=true next build",
    "________________ FORMAT AND LINT ________________": "",
    "lint": "eslint .",
    "lint:fix": "npm run lint -- --fix",
    "ts:check": "tsc --noEmit",
    "check": "npm run ts:check && npm run lint",
    "________________ OTHER ________________": "",
    "gen": "graphql-codegen --require dotenv/config --config codegen.yml",
    "update": "npx ncu -u && npx rimraf node_modules package-lock.json && npm i --legacy-peer-deps",
    "prepare": "husky",
    "postupdate": "npm run check && npm run lint:fix",
    "extract-translations": "npx i18next 'src/**/*.{tsx,ts}' -c i18next-parser.config.ts"
  },
  "dependencies": {
    "@apollo/client": "^3.12.3",
    "@babel/plugin-transform-class-properties": "^7.25.9",
    "@babel/plugin-transform-object-rest-spread": "^7.25.9",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@fontsource/roboto": "^5.1.0",
    "@hookform/resolvers": "^3.9.1",
    "@mui/icons-material": "^6.2.0",
    "@mui/lab": "^6.0.0-beta.19",
    "@mui/material": "^6.2.0",
    "@mui/styled-engine-sc": "^6.2.0",
    "@mui/x-date-pickers": "^7.23.2",
    "@mui/x-date-pickers-pro": "^7.23.2",
    "@next/bundle-analyzer": "^15.1.0",
    "@sentry/nextjs": "^8.44.0",
    "@vercel/og": "^0.6.4",
    "apollo3-cache-persist": "^0.15.0",
    "axios": "^1.7.9",
    "date-fns": "^4.1.0",
    "dayjs": "^1.11.13",
    "dotenv": "^16.4.7",
    "env-cmd": "^10.1.0",
    "graphql": "^16.9.0",
    "i18next": "^24.1.0",
    "next": "15.1.0",
    "next-compose-plugins": "^2.2.1",
    "next-i18next": "^15.4.0",
    "next-language-detector": "^1.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.1",
    "react-i18next": "^15.2.0",
    "sharp": "^0.33.5",
    "socket.io-client": "^4.8.1",
    "styled-components": "^6.1.13",
    "uuid": "^11.0.3",
    "yup": "^1.5.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@graphql-codegen/add": "^5.0.3",
    "@graphql-codegen/cli": "5.0.3",
    "@graphql-codegen/schema-ast": "^4.1.0",
    "@graphql-codegen/typescript": "4.1.2",
    "@graphql-codegen/typescript-operations": "4.4.0",
    "@graphql-codegen/typescript-react-apollo": "4.3.2",
    "@jetbrains/eslint-config": "^6.0.4",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.2",
    "@types/styled-components": "^5.1.34",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.1.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-comments": "^1.0.0",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-no-secrets": "^2.1.1",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-promise": "^7.2.1",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "eslint-plugin-security": "^3.0.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-sonarjs": "0.25.1",
    "eslint-plugin-unicorn": "^56.0.1",
    "husky": "^9.1.7",
    "i18next-parser": "^9.0.2",
    "npm-check-updates": "^17.1.11",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.4.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
}
